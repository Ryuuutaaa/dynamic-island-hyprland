# Tooling personal (bukan bagian dari proyek)
.commandcode/
.agents/

# Screenshot dev di root. Gambar yang memang dipublikasikan taruh di docs/
/*.png
/*.jpg
/*.jpeg

# Log, backup, dan file sementara
*.log
*.bak
*.tmp
*.swp

# Rahasia (API key). File asli ada di ~/.config/dynamic-iland/.env,
# tapi abaikan juga kalau ada yang membuatnya di root repo.
.env
.env.*
!.env.example

# URL iCal pribadi (secret). File asli ada di ~/.config/dynamic-iland/calendar.url
calendar.url

# OS / editor
.DS_Store

# Electron (jalur A: versi lintas OS)
desktop/node_modules/
desktop/.pnpm-store/
desktop/release/
# Salinan otomatis shared/ untuk Electron (dihasilkan tools/sync-shared.mjs)
desktop/src/shared/

# Situs dokumentasi Nuxt (docs/). Aset gambar di docs/public/shots/ ikut
# di-commit karena itu hasil tangkapan layar asli; hanya artefak build yang
# diabaikan.
docs/node_modules/
docs/.nuxt/
docs/.output/
docs/.data/
docs/dist/
docs/.pnpm-store/
